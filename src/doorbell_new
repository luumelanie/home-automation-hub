#include "lpc24xx.h"
#include "doorbell.h"
#include "play_tone.h"
#include "lcd/lcd_grph.h"
#include <stdint.h>

/* Doorbell button on P0.1 (bit 1) – active low with internal pull-up */
#define DOORBELL_BTN   (1u << 1)

/* Debounce timings (ms) */
#define DB_PRESS_MS    25u
#define DB_RELEASE_MS  25u

/* Read a millisecond tick. If you already wrapped T0TC, expose it here. */
extern uint32_t timer_get_tick(void);

/* Local state */
static uint8_t  stable_state = 1;       // 1=released (pull-up), 0=pressed
static uint8_t  last_reported = 1;
static uint32_t last_change_ms = 0;

/* One-shot re-trigger guard */
static uint8_t  armed = 1;

/* Optional: brief UI feedback duration */
static uint32_t ui_msg_until_ms = 0;

static inline uint8_t raw_btn(void) {
    /* Active-low: read FIO0PIN bit1 */
    return (FIO0PIN & DOORBELL_BTN) ? 1 : 0;
}

void doorbell_init(void)
{
    /* Set P0.1 as GPIO input */
    FIO0DIR &= ~DOORBELL_BTN;

    /* Enable internal pull-up on P0.1: PINMODE0 bits [3:2] = 00 */
    PINMODE0 &= ~(3u << 2);

    /* Prime debounce */
    uint32_t now = timer_get_tick();
    stable_state   = raw_btn();
    last_reported  = stable_state;
    last_change_ms = now;
    armed          = 1;
}

/* Simple blocking “ding-dong” melody using your play_tone() */
static void play_doorbell_sound(void)
{
    // quick two-note doorbell; adjust to taste
    play_tone(880, 160);   // A5 ~ 160 ms
    play_tone(660, 220);   // E5 ~ 220 ms
}

void doorbell_poll(void)
{
    uint32_t now = timer_get_tick();
    uint8_t  r   = raw_btn();

    if (r != stable_state) {
        /* edge in raw signal -> reset debounce timer */
        last_change_ms = now;
        stable_state   = r;
    } else {
        /* stable long enough? */
        uint32_t dwell = now - last_change_ms;
        if ((stable_state == 0 && dwell >= DB_PRESS_MS) ||
            (stable_state == 1 && dwell >= DB_RELEASE_MS)) {

            /* Report only when state actually changes after debounce */
            if (stable_state != last_reported) {
                last_reported = stable_state;

                /* Detect press (active-low) */
                if (stable_state == 0 && armed) {
                    // play sound (blocking ~380 ms total)
                    lcd_putString(10, 12, (unsigned char *)"Doorbell: DING-DONG");
                    ui_msg_until_ms = now + 600;
                    play_doorbell_sound();

                    /* Disarm until released to avoid repeat while held */
                    armed = 0;
                }

                /* Re-arm on release */
                if (stable_state == 1) {
                    armed = 1;
                }
            }
        }
    }

    /* Clear UI message after a short time */
    if (ui_msg_until_ms && ((int32_t)(now - ui_msg_until_ms) >= 0)) {
        // Overwrite the message line with spaces (same coords as above)
        lcd_putString(10, 12, (unsigned char *)"                      ");
        ui_msg_until_ms = 0;
    }
}
